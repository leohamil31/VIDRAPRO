NODE_ENV=development
PORT=4000

# Tenant queries run as app_api (RLS enforced). Admin = service role (signup, login lookup, webhooks).
DATABASE_URL_APP=postgres://app_api:change-me@localhost:5432/vidrapro
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/vidrapro

# local = built-in email/password · supabase = verify Supabase Auth JWTs
AUTH_MODE=local
JWT_SECRET=replace-with-a-64-char-random-string-replace-with-a-64-char-random
# SUPABASE_JWT_SECRET=
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
LOGO_BUCKET=logos

BILLING_WEBHOOK_SECRET=replace-with-a-long-random-secret
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
